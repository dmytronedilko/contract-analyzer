# Copy to apps/web/.env for `pnpm dev`. Docker Compose overrides the hostnames.
NODE_ENV=development

# Server-to-server URL of the API (never exposed to the browser).
BACKEND_URL=http://localhost:3001
# Mirrors the API's MAX_UPLOAD_MB; inlined into the client bundle at build time.
NEXT_PUBLIC_MAX_UPLOAD_MB=25

DATABASE_URL=postgres://postgres:postgres@localhost:5432/contracts
# Public origin of this app; also the JWT issuer the API checks (AUTH_ISSUER).
APP_URL=http://localhost:3000
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
AUTH_AUDIENCE=legal-rag-api
AUTH_SESSION_TTL_HOURS=12

# Optional, comma-separated.
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_ORG_CREATOR_EMAILS=

# Identity providers: each is enabled when all of its variables are set.
# Local development uses the mock OIDC provider from `pnpm services:up`.
AUTH_OIDC_NAME="Mock SSO"
AUTH_OIDC_ISSUER=http://localhost:8080/default
AUTH_OIDC_CLIENT_ID=contract-analyzer
AUTH_OIDC_CLIENT_SECRET=mock-secret

AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_TENANT_ID=

AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
