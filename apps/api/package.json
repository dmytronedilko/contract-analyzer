{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS + Fastify API: document ingestion, retrieval and contract analysis.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env --enable-source-maps\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fastify/multipart": "10.1.2",
    "@langchain/textsplitters": "1.0.1",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/drizzle": "0.0.1",
    "@nestjs/observe": "0.3.2",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pdf-parse": "2.4.5",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@nestjs/testing": "12.1.0",
    "@swc/core": "1.16.2",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  }
}
