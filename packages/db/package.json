{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database schema (app and Better Auth tables), migrations and the migrate script.",
  "license": "MIT",
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "auth:generate": "pnpm dlx auth@1.7.6 generate --adapter drizzle --dialect postgresql --config scripts/auth-schema.config.ts --output src/auth-schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env --enable-source-maps dist/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "better-auth": "1.7.6",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3"
  }
}
