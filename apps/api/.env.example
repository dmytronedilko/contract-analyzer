# Copy to apps/api/.env for `pnpm dev`. Docker Compose overrides the hostnames.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contracts

# AI providers (required).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2

RAG_TOP_K=5
# Keep in sync with NEXT_PUBLIC_MAX_UPLOAD_MB in apps/web/.env.
MAX_UPLOAD_MB=25

# Tokens are minted by the web app (Better Auth JWT plugin) and verified against its JWKS.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=legal-rag-api
RATE_LIMIT_ANALYSIS_PER_MINUTE=30
RATE_LIMIT_UPLOADS_PER_HOUR=20

# Optional: exact origins of trusted browser apps that call the API directly. Empty = CORS off.
CORS_ORIGINS=

# Optional: NestJS Observe. Leave the key and secret empty to disable instrumentation.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=legal-rag-api
OBSERVE_ENDPOINT=
OBSERVE_FORWARD_LOGS=false
OBSERVE_TRACES_SAMPLE_RATE=1
